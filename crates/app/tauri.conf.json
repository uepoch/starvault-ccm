{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StarVault CCM",
  "version": "0.1.6",
  "identifier": "dev.starvault.ccm",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "frontendDist": "ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "StarVault CCM",
        "width": 960,
        "height": 700,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE2NEYyN0FCNTJDMzJCNjYKUldSbUs4TlNxeWRQRnRZTHlrdEdieFNKWGhwK095L3czNkRUTUgzOFVoMWtSVFZKL0h4VUxEK1kK",
      "endpoints": [
        "https://github.com/uepoch/starvault-ccm/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}